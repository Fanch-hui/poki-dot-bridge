# Owner email allowlist (comma-separated, matched against oai-authenticated-user-email)
ALLOWED_OWNER_EMAILS=

# Trust ChatGPT Sites Sign-in header when ALLOWED_OWNER_EMAILS is unset (1 = trust, 0 = require allowlist)
TRUST_SITES_IDENTITY=1

# Optional static bearer token for direct MCP / API testing outside ChatGPT Sites OAuth
MCP_BEARER_TOKEN=

# Optional admin bearer token for automated admin API calls
ADMIN_API_TOKEN=

# Pepper mixed into device_token SHA-256 hashes stored in D1 (set a random 32+ byte secret in Sites Settings)
DEVICE_TOKEN_PEPPER=replace-with-strong-random-pepper

# OAuth authorization server advertised by /.well-known/oauth-protected-resource
OAUTH_AUTHORIZATION_SERVER=https://auth.openai.com

# Local development ONLY: auto-authenticate admin/MCP requests without headers (never set to 1 in production)
LOCAL_DEV_AUTO_AUTH=0

# R2 temporary screenshot TTL (seconds)
SCREENSHOT_TTL_SECONDS=900

# Active task lease duration (seconds) and default queued task TTL (seconds)
TASK_LEASE_SECONDS=25
TASK_DEFAULT_TTL_SECONDS=120

# Task / observation retention window in D1 (seconds)
RETENTION_SECONDS=604800

# Standalone local dev server settings
PORT=3000
LOCAL_DATA_DIR=.local-data
